/**
 * Netlify Serverless Function (v1 CommonJS): Site Stats
 *
 * 全局访问统计 — 所有用户的数据汇总存储在 Netlify Blobs 中。
 *
 * 架构选择说明：
 * - 使用 Serverless Function (Node.js)，不用 Edge Function (Deno)
 * - 原因：@netlify/blobs 的运行时上下文 (NETLIFY_BLOBS_CONTEXT) 只注入到 Serverless Functions
 * - 使用 CommonJS v1 格式（最广泛兼容），不用 ESM v2
 * - 路由通过 netlify.toml 中的 [[redirects]] 配置（/api/stats → /.netlify/functions/stats）
 */

const { getStore } = require("@netlify/blobs");

const HEADERS = {
  "Access-Control-Allow-Origin": "*",
  "Access-Control-Allow-Headers": "Content-Type",
  "Access-Control-Allow-Methods": "GET, POST, OPTIONS",
  "Content-Type": "application/json",
};

const EMPTY_STATS = { visits: 0, duration: 0, pageViews: 0, aiCalls: 0 };

function respond(statusCode, data) {
  return {
    statusCode,
    headers: HEADERS,
    body: JSON.stringify(data),
  };
}

exports.handler = async (event, context) => {
  const method = event.httpMethod;

  // CORS preflight
  if (method === "OPTIONS") {
    return { statusCode: 204, headers: HEADERS, body: "" };
  }

  // Initialize blob store
  let store;
  try {
    store = getStore("site-stats");
  } catch (e) {
    console.error("[stats] getStore failed:", e.message);
    return respond(200, { stats: { ...EMPTY_STATS }, _storeError: e.message });
  }

  // GET: return current stats
  if (method === "GET") {
    try {
      const data = await store.get("total", { type: "json" });
      return respond(200, { stats: data || { ...EMPTY_STATS } });
    } catch (e) {
      console.error("[stats] GET blob failed:", e.message);
      return respond(200, { stats: { ...EMPTY_STATS } });
    }
  }

  // POST: increment stats and return updated data
  if (method === "POST") {
    let body;
    try {
      body = JSON.parse(event.body || "{}");
    } catch (e) {
      return respond(400, { error: "Invalid JSON" });
    }

    const events = body.events;
    if (!events || !Array.isArray(events) || events.length === 0) {
      return respond(400, { error: "Missing events array" });
    }

    // Read current stats from blob store
    let current;
    try {
      current = await store.get("total", { type: "json" });
    } catch (e) {
      console.error("[stats] read blob failed:", e.message);
      current = null;
    }
    if (!current) {
      current = { visits: 0, duration: 0, pageViews: 0, aiCalls: 0 };
    }

    // Accumulate events
    for (var i = 0; i < events.length; i++) {
      var evt = events[i];
      if (evt === "visit") current.visits += 1;
      else if (evt === "pageView") current.pageViews += 1;
      else if (evt === "aiCall") current.aiCalls += 1;
      else if (typeof evt === "string" && evt.startsWith("duration:")) {
        current.duration += parseInt(evt.split(":")[1], 10) || 0;
      }
    }

    // Write back to blob store
    try {
      await store.setJSON("total", current);
    } catch (e) {
      console.error("[stats] write blob failed:", e.message);
      // If setJSON doesn't exist, try set with string
      try {
        await store.set("total", JSON.stringify(current));
      } catch (e2) {
        console.error("[stats] set fallback also failed:", e2.message);
      }
    }

    return respond(200, { ok: true, stats: current });
  }

  return respond(405, { error: "Method not allowed" });
};

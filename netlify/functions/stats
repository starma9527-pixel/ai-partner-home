/**
 * Netlify Serverless Function: Site Stats
 *
 * 全局访问统计 — 所有用户的累计数据存储在 Netlify Blobs 中。
 *
 * ★ 关键设计：零 npm 依赖 ★
 * - 不 require/import 任何第三方包（包括 @netlify/blobs）
 * - 直接解析 process.env.NETLIFY_BLOBS_CONTEXT（Netlify 自动注入的 base64 JSON）
 * - 用 Node 18 原生 fetch() 直接调用 Blobs HTTP API
 * - 这样即使 npm install 失败，函数依然能正常部署
 */

const HEADERS = {
  "Access-Control-Allow-Origin": "*",
  "Access-Control-Allow-Headers": "Content-Type",
  "Access-Control-Allow-Methods": "GET, POST, OPTIONS",
  "Content-Type": "application/json"
};

const STORE_NAME = "site-stats";
const BLOB_KEY = "total";

function respond(statusCode, data) {
  return { statusCode, headers: HEADERS, body: JSON.stringify(data) };
}

/**
 * 解析 Netlify Blobs 上下文
 * NETLIFY_BLOBS_CONTEXT 是 base64 编码的 JSON，包含:
 * { edgeURL, uncachedEdgeURL, siteID, token, ... }
 */
function parseBlobsContext() {
  var raw = process.env.NETLIFY_BLOBS_CONTEXT;
  if (!raw) return null;
  try {
    var decoded = Buffer.from(raw, "base64").toString("utf-8");
    var ctx = JSON.parse(decoded);
    return ctx;
  } catch (e) {
    console.error("[stats] Failed to parse NETLIFY_BLOBS_CONTEXT:", e.message);
    return null;
  }
}

/**
 * 构建 Blob URL: {edgeURL}/{siteID}/site:{storeName}/{key}
 */
function blobUrl(ctx) {
  var base = (ctx.uncachedEdgeURL || ctx.edgeURL || "").replace(/\/+$/, "");
  return base + "/" + ctx.siteID + "/site:" + STORE_NAME + "/" + BLOB_KEY;
}

/**
 * 从 Blobs 读取统计数据
 */
async function readStats(ctx) {
  var url = blobUrl(ctx);
  try {
    var resp = await fetch(url, {
      method: "GET",
      headers: { "authorization": "Bearer " + ctx.token }
    });
    if (resp.status === 404) return null;
    if (!resp.ok) {
      console.error("[stats] GET blob HTTP", resp.status, await resp.text().catch(function() { return ""; }));
      return null;
    }
    var text = await resp.text();
    if (!text || text.trim() === "") return null;
    return JSON.parse(text);
  } catch (e) {
    console.error("[stats] readStats error:", e.message);
    return null;
  }
}

/**
 * 写入统计数据到 Blobs
 */
async function writeStats(ctx, data) {
  var url = blobUrl(ctx);
  try {
    var resp = await fetch(url, {
      method: "PUT",
      headers: {
        "authorization": "Bearer " + ctx.token,
        "content-type": "application/json"
      },
      body: JSON.stringify(data)
    });
    if (!resp.ok) {
      var errText = await resp.text().catch(function() { return ""; });
      console.error("[stats] PUT blob HTTP", resp.status, errText);
      return false;
    }
    return true;
  } catch (e) {
    console.error("[stats] writeStats error:", e.message);
    return false;
  }
}

exports.handler = async function(event) {
  var method = event.httpMethod;

  // CORS preflight
  if (method === "OPTIONS") {
    return { statusCode: 204, headers: HEADERS, body: "" };
  }

  // Debug 诊断端点: GET /api/stats?debug=1
  if (method === "GET" && event.queryStringParameters && event.queryStringParameters.debug === "1") {
    var rawCtx = process.env.NETLIFY_BLOBS_CONTEXT;
    var hasFetch = typeof fetch !== "undefined";
    var nodeVer = process.version;
    var ctxParsed = parseBlobsContext();
    return respond(200, {
      _debug: true,
      deployed: true,
      nodeVersion: nodeVer,
      hasFetch: hasFetch,
      hasBlobsContext: !!rawCtx,
      blobsContextLength: rawCtx ? rawCtx.length : 0,
      contextKeys: ctxParsed ? Object.keys(ctxParsed) : [],
      hasSiteID: ctxParsed ? !!ctxParsed.siteID : false,
      hasToken: ctxParsed ? !!ctxParsed.token : false,
      hasEdgeURL: ctxParsed ? !!(ctxParsed.edgeURL || ctxParsed.uncachedEdgeURL) : false,
      timestamp: new Date().toISOString()
    });
  }

  // 解析 Blobs 上下文
  var ctx = parseBlobsContext();
  if (!ctx || !ctx.siteID || !ctx.token || !(ctx.edgeURL || ctx.uncachedEdgeURL)) {
    console.error("[stats] Blobs context missing or incomplete. NETLIFY_BLOBS_CONTEXT exists:", !!process.env.NETLIFY_BLOBS_CONTEXT);
    // 返回空统计而不报错，前端仍能正常显示
    return respond(200, { stats: { visits: 0, duration: 0, pageViews: 0, aiCalls: 0 }, _error: "blobs_context_unavailable" });
  }

  // GET: 返回当前统计
  if (method === "GET") {
    var data = await readStats(ctx);
    return respond(200, { stats: data || { visits: 0, duration: 0, pageViews: 0, aiCalls: 0 } });
  }

  // POST: 累加统计并返回
  if (method === "POST") {
    var body;
    try {
      body = JSON.parse(event.body || "{}");
    } catch (e) {
      return respond(400, { error: "Invalid JSON" });
    }

    var events = body.events;
    if (!events || !Array.isArray(events) || events.length === 0) {
      return respond(400, { error: "Missing events array" });
    }

    // 读取当前统计
    var current = await readStats(ctx);
    if (!current) {
      current = { visits: 0, duration: 0, pageViews: 0, aiCalls: 0 };
    }

    // 确保所有字段都是数字
    current.visits = Number(current.visits) || 0;
    current.duration = Number(current.duration) || 0;
    current.pageViews = Number(current.pageViews) || 0;
    current.aiCalls = Number(current.aiCalls) || 0;

    // 累加事件
    for (var i = 0; i < events.length; i++) {
      var evt = events[i];
      if (evt === "visit") current.visits += 1;
      else if (evt === "pageView") current.pageViews += 1;
      else if (evt === "aiCall") current.aiCalls += 1;
      else if (typeof evt === "string" && evt.indexOf("duration:") === 0) {
        current.duration += parseInt(evt.split(":")[1], 10) || 0;
      }
    }

    // 写回 Blobs
    var ok = await writeStats(ctx, current);
    return respond(200, { ok: ok, stats: current });
  }

  return respond(405, { error: "Method not allowed" });
};

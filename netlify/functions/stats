/**
 * Netlify Serverless Function: Site Stats (全局访问统计)
 * 使用 Netlify Blobs 做服务端持久化存储，汇总所有用户数据
 * 注意：用 Serverless Function（Node.js）而非 Edge Function（Deno），Blobs 兼容性更好
 */
const { getStore } = require("@netlify/blobs");

const CORS_HEADERS = {
  'Access-Control-Allow-Origin': '*',
  'Access-Control-Allow-Headers': 'Content-Type',
  'Access-Control-Allow-Methods': 'GET, POST, OPTIONS',
  'Content-Type': 'application/json',
  'Cache-Control': 'no-cache, no-store'
};

function getTimeKeys() {
  const now = new Date();
  const y = now.getFullYear();
  const m = String(now.getMonth() + 1).padStart(2, '0');
  const d = String(now.getDate()).padStart(2, '0');
  // ISO week number
  const tmp = new Date(now);
  tmp.setHours(0, 0, 0, 0);
  tmp.setDate(tmp.getDate() + 3 - ((tmp.getDay() + 6) % 7));
  const week1 = new Date(tmp.getFullYear(), 0, 4);
  const wn = 1 + Math.round(((tmp.getTime() - week1.getTime()) / 86400000 - 3 + ((week1.getDay() + 6) % 7)) / 7);
  return {
    day:   y + '-' + m + '-' + d,
    week:  y + '-W' + String(wn).padStart(2, '0'),
    month: y + '-' + m,
    year:  '' + y
  };
}

const EMPTY = { visits: 0, duration: 0, pageViews: 0, aiCalls: 0 };

exports.handler = async function(event) {
  // CORS preflight
  if (event.httpMethod === 'OPTIONS') {
    return { statusCode: 204, headers: CORS_HEADERS, body: '' };
  }

  let store;
  try {
    store = getStore({ name: 'site-stats', consistency: 'strong' });
  } catch (e) {
    console.error('[stats] getStore failed:', e.message);
    return {
      statusCode: 500,
      headers: CORS_HEADERS,
      body: JSON.stringify({ error: 'Store init failed: ' + e.message })
    };
  }

  try {
    // GET: 返回各时间维度的统计数据
    if (event.httpMethod === 'GET') {
      const keys = getTimeKeys();
      let day = null, week = null, month = null, year = null;
      try { day = await store.get(keys.day, { type: 'json' }); } catch (e) { console.error('[stats] get day err:', e.message); }
      try { week = await store.get(keys.week, { type: 'json' }); } catch (e) { console.error('[stats] get week err:', e.message); }
      try { month = await store.get(keys.month, { type: 'json' }); } catch (e) { console.error('[stats] get month err:', e.message); }
      try { year = await store.get(keys.year, { type: 'json' }); } catch (e) { console.error('[stats] get year err:', e.message); }

      return {
        statusCode: 200,
        headers: CORS_HEADERS,
        body: JSON.stringify({
          today: day || { ...EMPTY },
          week:  week || { ...EMPTY },
          month: month || { ...EMPTY },
          year:  year || { ...EMPTY }
        })
      };
    }

    // POST: 记录事件
    if (event.httpMethod === 'POST') {
      const body = JSON.parse(event.body || '{}');
      const events = body.events;
      if (!events || !Array.isArray(events) || events.length === 0) {
        return {
          statusCode: 400,
          headers: CORS_HEADERS,
          body: JSON.stringify({ error: 'Missing events' })
        };
      }

      const keys = getTimeKeys();
      const periodEntries = [
        { key: keys.day,   label: 'day' },
        { key: keys.week,  label: 'week' },
        { key: keys.month, label: 'month' },
        { key: keys.year,  label: 'year' }
      ];

      // 逐个读取、更新、写回（顺序执行避免竞态）
      for (const entry of periodEntries) {
        let data;
        try {
          data = await store.get(entry.key, { type: 'json' });
        } catch (e) {
          console.error('[stats] read ' + entry.label + ' err:', e.message);
        }
        if (!data) data = { visits: 0, duration: 0, pageViews: 0, aiCalls: 0 };

        for (const evt of events) {
          if (evt === 'visit') data.visits += 1;
          else if (evt === 'pageView') data.pageViews += 1;
          else if (evt === 'aiCall') data.aiCalls += 1;
          else if (evt.startsWith('duration:')) {
            data.duration += (parseInt(evt.split(':')[1], 10) || 0);
          }
        }

        try {
          await store.setJSON(entry.key, data);
        } catch (e) {
          console.error('[stats] write ' + entry.label + ' err:', e.message);
          // 如果 setJSON 失败，尝试用 set + JSON.stringify
          try {
            await store.set(entry.key, JSON.stringify(data));
          } catch (e2) {
            console.error('[stats] set fallback ' + entry.label + ' err:', e2.message);
          }
        }
      }

      return {
        statusCode: 200,
        headers: CORS_HEADERS,
        body: JSON.stringify({ ok: true })
      };
    }

    return {
      statusCode: 405,
      headers: CORS_HEADERS,
      body: JSON.stringify({ error: 'Method not allowed' })
    };
  } catch (err) {
    console.error('[stats] Error:', err);
    return {
      statusCode: 500,
      headers: CORS_HEADERS,
      body: JSON.stringify({ error: err.message })
    };
  }
};

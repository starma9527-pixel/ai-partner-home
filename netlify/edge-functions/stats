/**
 * Netlify Serverless Function (v2): Site Stats
 *
 * 全局访问统计 — 所有用户的数据汇总存储在 Netlify Blobs 中。
 *
 * 为什么用 Serverless Function 而不是 Edge Function？
 * Edge Functions (Deno) 中 Netlify Blobs 的上下文变量不可用，
 * 导致 getStore / getBlobContext 永远返回 null → 数据始终为 0。
 * Serverless Functions (Node.js) 是 @netlify/blobs 的官方支持运行时。
 */

import { getStore } from "@netlify/blobs";

const CORS_HEADERS = {
  "Access-Control-Allow-Origin": "*",
  "Access-Control-Allow-Headers": "Content-Type",
  "Access-Control-Allow-Methods": "GET, POST, OPTIONS",
};

function jsonResponse(data, status = 200) {
  return new Response(JSON.stringify(data), {
    status,
    headers: { ...CORS_HEADERS, "Content-Type": "application/json" },
  });
}

const EMPTY_STATS = { visits: 0, duration: 0, pageViews: 0, aiCalls: 0 };
const STORE_NAME = "site-stats";
const STORE_KEY = "total";

export default async (request, context) => {
  // CORS preflight
  if (request.method === "OPTIONS") {
    return new Response("", { status: 204, headers: CORS_HEADERS });
  }

  // Initialize blob store
  let store;
  try {
    store = getStore(STORE_NAME);
  } catch (e) {
    console.error("[stats] getStore failed:", e.message);
    return jsonResponse({ stats: { ...EMPTY_STATS }, _storeError: e.message });
  }

  // GET: return current stats
  if (request.method === "GET") {
    try {
      const data = await store.get(STORE_KEY, { type: "json" });
      return jsonResponse({ stats: data || { ...EMPTY_STATS } });
    } catch (e) {
      console.error("[stats] GET failed:", e.message);
      return jsonResponse({ stats: { ...EMPTY_STATS } });
    }
  }

  // POST: increment stats and return updated data
  if (request.method === "POST") {
    let body;
    try {
      body = await request.json();
    } catch (e) {
      return jsonResponse({ error: "Invalid JSON" }, 400);
    }

    const events = body.events;
    if (!events || !Array.isArray(events) || events.length === 0) {
      return jsonResponse({ error: "Missing events array" }, 400);
    }

    // Read current stats
    let current;
    try {
      current = await store.get(STORE_KEY, { type: "json" });
    } catch (e) {
      console.error("[stats] read failed:", e.message);
      current = null;
    }
    if (!current) {
      current = { visits: 0, duration: 0, pageViews: 0, aiCalls: 0 };
    }

    // Process events
    for (const evt of events) {
      if (evt === "visit") current.visits += 1;
      else if (evt === "pageView") current.pageViews += 1;
      else if (evt === "aiCall") current.aiCalls += 1;
      else if (typeof evt === "string" && evt.startsWith("duration:")) {
        current.duration += parseInt(evt.split(":")[1], 10) || 0;
      }
    }

    // Write back
    try {
      await store.setJSON(STORE_KEY, current);
    } catch (e) {
      console.error("[stats] write failed:", e.message);
    }

    return jsonResponse({ ok: true, stats: current });
  }

  return jsonResponse({ error: "Method not allowed" }, 405);
};

export const config = {
  path: "/api/stats",
};

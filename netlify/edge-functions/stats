/**
 * Netlify Edge Function: Site Stats (全局访问统计)
 * 使用 Netlify Blobs 做服务端持久化存储，汇总所有用户数据
 */
import { getStore } from "@netlify/blobs";

const CORS_HEADERS = {
  'Access-Control-Allow-Origin': '*',
  'Access-Control-Allow-Headers': 'Content-Type',
  'Access-Control-Allow-Methods': 'GET, POST, OPTIONS',
  'Access-Control-Max-Age': '86400'
};

function getTimeKeys() {
  const now = new Date();
  const y = now.getFullYear();
  const m = String(now.getMonth() + 1).padStart(2, '0');
  const d = String(now.getDate()).padStart(2, '0');
  const tmp = new Date(now);
  tmp.setHours(0, 0, 0, 0);
  tmp.setDate(tmp.getDate() + 3 - ((tmp.getDay() + 6) % 7));
  const week1 = new Date(tmp.getFullYear(), 0, 4);
  const wn = 1 + Math.round(((tmp.getTime() - week1.getTime()) / 86400000 - 3 + ((week1.getDay() + 6) % 7)) / 7);
  return {
    day:   `${y}-${m}-${d}`,
    week:  `${y}-W${String(wn).padStart(2, '0')}`,
    month: `${y}-${m}`,
    year:  `${y}`
  };
}

const EMPTY = { visits: 0, duration: 0, pageViews: 0, aiCalls: 0 };

function jsonResp(data, status = 200) {
  return new Response(JSON.stringify(data), {
    status,
    headers: { ...CORS_HEADERS, 'Content-Type': 'application/json', 'Cache-Control': 'no-cache, no-store' }
  });
}

export default async function handler(req, context) {
  if (req.method === 'OPTIONS') {
    return new Response(null, { status: 204, headers: CORS_HEADERS });
  }

  let store;
  try {
    store = getStore({ name: 'site-stats', consistency: 'strong' });
  } catch (e1) {
    console.error('[stats] getStore with options failed, trying simple name:', e1.message);
    try {
      store = getStore('site-stats');
    } catch (e2) {
      console.error('[stats] getStore simple also failed:', e2.message);
      return jsonResp({ error: 'Store init failed: ' + e2.message }, 500);
    }
  }

  try {
    if (req.method === 'GET') {
      const keys = getTimeKeys();
      const results = await Promise.allSettled([
        store.get(keys.day, { type: 'json' }),
        store.get(keys.week, { type: 'json' }),
        store.get(keys.month, { type: 'json' }),
        store.get(keys.year, { type: 'json' })
      ]);
      const [day, week, month, year] = results.map(r => r.status === 'fulfilled' ? r.value : null);
      return jsonResp({
        today: day || { ...EMPTY },
        week:  week || { ...EMPTY },
        month: month || { ...EMPTY },
        year:  year || { ...EMPTY },
        _keys: keys,
        _debug: results.map(r => r.status)
      });
    }

    if (req.method === 'POST') {
      const body = await req.json();
      const { events } = body;
      if (!events || !Array.isArray(events) || events.length === 0) {
        return jsonResp({ error: 'Missing events' }, 400);
      }

      const keys = getTimeKeys();
      const periodKeys = [keys.day, keys.week, keys.month, keys.year];

      // 逐个读取当前值（用 allSettled 避免单个失败导致全部失败）
      const readResults = await Promise.allSettled(
        periodKeys.map(k => store.get(k, { type: 'json' }))
      );
      const periods = readResults.map(r =>
        r.status === 'fulfilled' && r.value ? { ...r.value } : { ...EMPTY }
      );

      // 叠加事件
      for (const evt of events) {
        for (const p of periods) {
          if (evt === 'visit') p.visits += 1;
          else if (evt === 'pageView') p.pageViews += 1;
          else if (evt === 'aiCall') p.aiCalls += 1;
          else if (evt.startsWith('duration:')) {
            const secs = parseInt(evt.split(':')[1], 10) || 0;
            p.duration += secs;
          }
        }
      }

      // 逐个写回（用 set + JSON.stringify 作为 setJSON 的替代方案，更稳健）
      const writeResults = await Promise.allSettled(
        periodKeys.map((k, i) => store.set(k, JSON.stringify(periods[i])))
      );

      const writeStatuses = writeResults.map(r => r.status);
      const allOk = writeStatuses.every(s => s === 'fulfilled');

      return jsonResp({
        ok: allOk,
        events: events,
        _writeStatuses: writeStatuses,
        _periods: periods
      });
    }

    return jsonResp({ error: 'Method not allowed' }, 405);
  } catch (err) {
    console.error('[stats] Error:', err);
    return jsonResp({ error: err.message, stack: err.stack }, 500);
  }
}

/**
 * Netlify Edge Function: Site Stats (全局访问统计)
 * 使用 @netlify/blobs 持久化存储，所有用户共享同一份计数器
 *
 * 关键点：
 *   1. getStore 必须在 handler 内部调用（不能在模块顶层）
 *   2. 使用 consistency: "strong" 确保写后读一致性
 *   3. Edge Function 运行时自动注入 siteID 和 token
 */
import { getStore } from "@netlify/blobs";

const CORS = {
  "Access-Control-Allow-Origin": "*",
  "Access-Control-Allow-Headers": "Content-Type",
  "Access-Control-Allow-Methods": "GET, POST, OPTIONS",
  "Content-Type": "application/json",
  "Cache-Control": "no-cache, no-store"
};

function getTimeKeys() {
  const now = new Date();
  const y = now.getFullYear();
  const m = String(now.getMonth() + 1).padStart(2, "0");
  const d = String(now.getDate()).padStart(2, "0");
  const tmp = new Date(now);
  tmp.setHours(0, 0, 0, 0);
  tmp.setDate(tmp.getDate() + 3 - ((tmp.getDay() + 6) % 7));
  const week1 = new Date(tmp.getFullYear(), 0, 4);
  const wn = 1 + Math.round(((tmp.getTime() - week1.getTime()) / 86400000 - 3 + ((week1.getDay() + 6) % 7)) / 7);
  return {
    day:   y + "-" + m + "-" + d,
    week:  y + "-W" + String(wn).padStart(2, "0"),
    month: y + "-" + m,
    year:  "" + y
  };
}

function jsonResp(status, data) {
  return new Response(JSON.stringify(data), { status, headers: CORS });
}

const EMPTY = { visits: 0, duration: 0, pageViews: 0, aiCalls: 0 };

export default async (request, context) => {
  // CORS preflight
  if (request.method === "OPTIONS") {
    return new Response(null, { status: 204, headers: CORS });
  }

  // 诊断模式：GET /api/stats?debug=1
  const url = new URL(request.url);
  if (url.searchParams.get("debug") === "1") {
    let storeOk = false;
    let storeErr = null;
    try {
      const s = getStore({ name: "site-stats", consistency: "strong" });
      await s.get("__ping", { type: "text" }).catch(() => null);
      storeOk = true;
    } catch (e) {
      storeErr = e.message;
    }
    return jsonResp(200, {
      ok: true,
      storeAvailable: storeOk,
      storeError: storeErr,
      time: new Date().toISOString(),
      keys: getTimeKeys()
    });
  }

  try {
    // 关键：在 handler 内部初始化 store，使用 strong consistency
    const store = getStore({ name: "site-stats", consistency: "strong" });
    const keys = getTimeKeys();

    // GET: 返回各时间维度的统计数据
    if (request.method === "GET") {
      const [dayData, weekData, monthData, yearData] = await Promise.all([
        store.get(keys.day,   { type: "json" }).catch(() => null),
        store.get(keys.week,  { type: "json" }).catch(() => null),
        store.get(keys.month, { type: "json" }).catch(() => null),
        store.get(keys.year,  { type: "json" }).catch(() => null)
      ]);

      return jsonResp(200, {
        today: dayData  || { ...EMPTY },
        week:  weekData || { ...EMPTY },
        month: monthData || { ...EMPTY },
        year:  yearData  || { ...EMPTY }
      });
    }

    // POST: 记录事件并返回更新后的统计数据
    if (request.method === "POST") {
      let body;
      try {
        body = await request.json();
      } catch (e) {
        return jsonResp(400, { error: "Invalid JSON body" });
      }

      const events = body.events;
      if (!events || !Array.isArray(events) || events.length === 0) {
        return jsonResp(400, { error: "Missing events array" });
      }

      const allKeys = [keys.day, keys.week, keys.month, keys.year];
      const labels = ["today", "week", "month", "year"];
      const updated = {};

      for (let k = 0; k < allKeys.length; k++) {
        const key = allKeys[k];
        let data;
        try {
          data = await store.get(key, { type: "json" });
        } catch (e) {
          data = null;
        }
        if (!data) data = { visits: 0, duration: 0, pageViews: 0, aiCalls: 0 };

        for (let i = 0; i < events.length; i++) {
          const evt = events[i];
          if (evt === "visit") data.visits += 1;
          else if (evt === "pageView") data.pageViews += 1;
          else if (evt === "aiCall") data.aiCalls += 1;
          else if (typeof evt === "string" && evt.startsWith("duration:")) {
            data.duration += (parseInt(evt.split(":")[1], 10) || 0);
          }
        }

        await store.setJSON(key, data);
        updated[labels[k]] = data;
      }

      return jsonResp(200, {
        ok: true,
        stats: {
          today: updated.today || { ...EMPTY },
          week:  updated.week  || { ...EMPTY },
          month: updated.month || { ...EMPTY },
          year:  updated.year  || { ...EMPTY }
        }
      });
    }

    return jsonResp(405, { error: "Method not allowed" });
  } catch (err) {
    console.error("[stats] Error:", err);
    // 即使出错也返回有效的空数据结构，前端不会崩溃
    return jsonResp(200, {
      error: err.message || "Internal error",
      today: { ...EMPTY },
      week:  { ...EMPTY },
      month: { ...EMPTY },
      year:  { ...EMPTY }
    });
  }
};
